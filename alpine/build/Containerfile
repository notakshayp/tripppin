# Builder for the Tripppin Alpine image: abuild (packages) and aports mkimage (ISO).
# Pinned: Alpine 3.24.4 base container (multi-arch index digest), aports at the v3.24.4 release
# commit, fetched from the official GitHub mirror (gitlab.alpinelinux.org refuses CI runners).
FROM docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ARG APORTS_REV=105b835acd9971b9770fb61f5a1ddcc133c180dc
RUN apk add --no-cache alpine-sdk abuild apk-tools alpine-conf busybox fakeroot xorriso squashfs-tools \
      mtools dosfstools grub grub-efi mkinitfs cargo rust git bash cmake samurai \
      vulkan-headers vulkan-loader-dev shaderc glslang spirv-headers curl openssl sudo \
 && adduser -D -G abuild builder && echo "builder ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/builder \
 && install -d -o builder -g abuild /home/builder/work \
 && { [ "$(uname -m)" != x86_64 ] || apk add --no-cache syslinux; }
RUN su builder -c "cd /home/builder && git init -q aports && cd aports \
      && git remote add origin https://github.com/alpinelinux/aports.git \
      && git fetch -q --depth 1 origin $APORTS_REV && git checkout -q FETCH_HEAD"
