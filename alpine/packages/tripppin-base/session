#!/bin/sh
# Start the invisible compositor on the console. Returns when it exits.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export LIBSEAT_BACKEND=seatd
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export EDITOR="${EDITOR:-vi}"
[ -d "$XDG_RUNTIME_DIR" ] || { echo "tripppin: $XDG_RUNTIME_DIR missing (is trip-runtime up?)"; exit 1; }
cfg=/etc/tripppin/sway.conf
[ -f "$HOME/.config/tripppin/sway.conf" ] && cfg="$HOME/.config/tripppin/sway.conf"
# Vulkan renderer on real GPUs; if the compositor dies at once (no Vulkan), use pixman.
# Virtual GPUs go straight to pixman: with a GL virtio device Vulkan can hang instead of failing.
renderers="vulkan pixman"
grep -qs virtio_gpu /sys/class/drm/card*/device/uevent && renderers=pixman
for r in $renderers; do
    start=$(date +%s)
    WLR_RENDERER=$r dbus-run-session sway -c "$cfg" 2>"$XDG_RUNTIME_DIR/sway-$r.log"
    [ $(( $(date +%s) - start )) -gt 5 ] && break
done
echo "tripppin: compositor exited (logs: $XDG_RUNTIME_DIR/sway-*.log)"
