# Tripppin OS image.
#
# Build from the repository root:
#   podman build -f os/Containerfile -t localhost/tripppin .
#
# Base images are pinned by digest. Dependabot opens a PR when Fedora publishes
# a new one, and that PR runs the full image pipeline before it can merge.

# ---- Rust tools -------------------------------------------------------------
FROM quay.io/fedora/fedora:45@sha256:db14be5698ea04f1f9a4f4fb31945205a696a01f1466cf4a7e5f5a77ca3c7a82 AS build
RUN dnf -y install --setopt=install_weak_deps=False cargo rust gcc gtk4-devel gtk4-layer-shell-devel && dnf clean all
WORKDIR /src
COPY Cargo.toml Cargo.lock rustfmt.toml ./
COPY crates crates
COPY models models
RUN cargo build --release --locked -p trip -p tripppin-ui

# ---- llama.cpp ------------------------------------------------------------
# Pinned release, Vulkan backend (falls back to the CPU when there's no GPU).
FROM quay.io/fedora/fedora:45@sha256:db14be5698ea04f1f9a4f4fb31945205a696a01f1466cf4a7e5f5a77ca3c7a82 AS llama
ARG LLAMA_CPP_TAG=v1.0.0
RUN dnf -y install --setopt=install_weak_deps=False git cmake gcc-c++ vulkan-headers vulkan-loader-devel glslc spirv-headers-devel && dnf clean all
RUN git clone --depth 1 --branch "$LLAMA_CPP_TAG" https://github.com/ggml-org/llama.cpp /src/llama.cpp
WORKDIR /src/llama.cpp
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_VULKAN=ON \
      -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON \
      -DLLAMA_USE_PREBUILT_UI=OFF -DLLAMA_BUILD_HTML=OFF \
    && cmake --build build --target llama-server -j"$(nproc)"

# ---- whisper.cpp ----------------------------------------------------------
# Dictation's speech to text. Fedora's whisper-cpp package ships only the libraries, no
# whisper-cli, so build the pinned release (CPU only; the base model is fast enough there).
FROM quay.io/fedora/fedora:45@sha256:db14be5698ea04f1f9a4f4fb31945205a696a01f1466cf4a7e5f5a77ca3c7a82 AS whisper
ARG WHISPER_CPP_TAG=v1.8.7
RUN dnf -y install --setopt=install_weak_deps=False git cmake gcc-c++ && dnf clean all
RUN git clone --depth 1 --branch "$WHISPER_CPP_TAG" https://github.com/ggml-org/whisper.cpp /src/whisper.cpp
WORKDIR /src/whisper.cpp
RUN if [ "$(uname -m)" = x86_64 ]; then X86="-DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON"; fi; \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF $X86 \
      -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF -DWHISPER_BUILD_EXAMPLES=ON \
    && cmake --build build --target whisper-cli -j"$(nproc)"

# ---- The OS -----------------------------------------------------------------
FROM quay.io/fedora/fedora-bootc:45@sha256:d440aea898005f376bbf0bbe06c216abdba68dcdb6dfa5cb0fa246cd03fa8d8a

LABEL org.opencontainers.image.title="tripppin" \
      org.opencontainers.image.description="A Linux with an AI built in." \
      org.opencontainers.image.source="https://github.com/notakshayp/tripppin" \
      org.opencontainers.image.licenses="Apache-2.0" \
      containers.bootc="1"

# Apply every Fedora update published since the base image was cut, so the
# image never ships a fix that already exists upstream.
RUN dnf -y upgrade --refresh && dnf clean all

# toolbox in Fedora 45 is built with a pre-release Go (CVE-2026-78663, critical).
# We don't need it until milestone 6; re-add it once Fedora ships a rebuilt package.
RUN dnf -y remove toolbox && dnf clean all

# Fedora 45 keeps its repo definitions in /usr/share/dnf5/repos.d, but the ISO
# builder only reads /etc/yum.repos.d. Copy them so it can resolve installer packages.
RUN cp -n /usr/share/dnf5/repos.d/*.repo /etc/yum.repos.d/

COPY --from=build /src/target/release/trip /usr/bin/trip
COPY --from=build /src/target/release/tripppin-ui /usr/bin/tripppin-ui
COPY --from=llama /src/llama.cpp/build/bin/llama-server /usr/bin/llama-server
COPY --from=llama /src/llama.cpp/LICENSE /usr/share/licenses/llama.cpp/LICENSE
COPY --from=whisper /src/whisper.cpp/build/bin/whisper-cli /usr/bin/whisper-cli
COPY --from=whisper /src/whisper.cpp/LICENSE /usr/share/licenses/whisper.cpp/LICENSE
# Dictation's speech model: multilingual base, 5-bit (MIT, ggerganov/whisper.cpp), pinned to a revision and checked.
ARG WHISPER_MODEL_REV=5359861c739e955e79d9a303bcbc70fb988958b1
ARG WHISPER_MODEL_SHA256=422f1ae452ade6f30a004d7e5c6a43195e4433bc370bf23fac9cc591f01a8898
ADD --checksum=sha256:${WHISPER_MODEL_SHA256} https://huggingface.co/ggerganov/whisper.cpp/resolve/${WHISPER_MODEL_REV}/ggml-base-q5_1.bin /usr/share/tripppin/whisper/ggml-base-q5_1.bin

# What llama.cpp needs at runtime: the Vulkan loader and Mesa's GPU drivers.
RUN dnf -y install --setopt=install_weak_deps=False vulkan-loader mesa-vulkan-drivers libgomp && dnf clean all

# Wi-Fi: NetworkManager's Wi-Fi plugin and wpa_supplicant, plus firmware for the
# common laptop chips (Intel, Realtek, MediaTek, Atheros, Broadcom).
RUN dnf -y install --setopt=install_weak_deps=False NetworkManager-wifi wpa_supplicant \
      iwlwifi-mvm-firmware iwlwifi-dvm-firmware realtek-firmware mt7xxx-firmware atheros-firmware brcmfmac-firmware \
    && dnf clean all

# Apps install as Flatpaks from Flathub, since the system image itself is read-only. The
# Store (tripppin-ui store, trip store) is our front end to that catalogue. The remote is
# configured system-wide, so everyone on the computer sees the same apps.
ARG FLATHUBREPO_SHA256=3371dd250e61d9e1633630073fefda153cd4426f72f4afa0c3373ae2e8fea03a
RUN dnf -y install --setopt=install_weak_deps=False flatpak && dnf clean all \
    && mkdir -p /usr/share/flatpak/remotes.d \
    && curl -fsSL -o /usr/share/flatpak/remotes.d/flathub.flatpakrepo https://dl.flathub.org/repo/flathub.flatpakrepo \
    && echo "${FLATHUBREPO_SHA256}  /usr/share/flatpak/remotes.d/flathub.flatpakrepo" | sha256sum -c - \
    && flatpak remote-add --system --if-not-exists flathub /usr/share/flatpak/remotes.d/flathub.flatpakrepo

# The console: kmscon (scrollback, mouse, real fonts) in DM Mono, with DejaVu Sans
# Mono for the block and line characters DM Mono doesn't have.
ARG DM_MONO_REV=85f32a0254c400b643d7ce589b91a2ad29bea73b
ARG DM_MONO_SHA256=55b4c98f123daebb3ed27947ba47b2af00554fc6284d639a540bcef5e6258ad2
RUN dnf -y install --setopt=install_weak_deps=False kmscon kmscon-pango dejavu-sans-mono-fonts && dnf clean all \
    && mkdir -p /usr/share/fonts/dm-mono /usr/share/licenses/dm-mono \
    && curl -fsSL -o /usr/share/fonts/dm-mono/DMMono-Regular.ttf \
         "https://raw.githubusercontent.com/google/fonts/${DM_MONO_REV}/ofl/dmmono/DMMono-Regular.ttf" \
    && echo "${DM_MONO_SHA256}  /usr/share/fonts/dm-mono/DMMono-Regular.ttf" | sha256sum -c - \
    && curl -fsSL -o /usr/share/licenses/dm-mono/OFL.txt \
         "https://raw.githubusercontent.com/google/fonts/${DM_MONO_REV}/ofl/dmmono/OFL.txt" \
    && fc-cache -f

# Icons for the bar, quick settings and our screens: Lucide (ISC), as a font, so GTK 3
# and GTK 4 draw the same line icons at any size and in any colour.
ARG LUCIDE_VERSION=1.66.0
ARG LUCIDE_SHA256=c6355db6e4f0834f62193f9effde900dab785c5c18877cf95cd1a44fa62fa8d5
RUN mkdir -p /usr/share/fonts/lucide /usr/share/licenses/lucide \
    && curl -fsSL -o /usr/share/fonts/lucide/lucide.ttf "https://unpkg.com/lucide-static@${LUCIDE_VERSION}/font/lucide.ttf" \
    && echo "${LUCIDE_SHA256}  /usr/share/fonts/lucide/lucide.ttf" | sha256sum -c - \
    && curl -fsSL -o /usr/share/licenses/lucide/LICENSE "https://unpkg.com/lucide-static@${LUCIDE_VERSION}/LICENSE" \
    && fc-cache -f

# The desktop: KDE Plasma 6 on KWin (Wayland), a lean explicit set rather than the whole
# @kde-desktop group, restyled end to end by os/files (the "Tripppin" look-and-feel package,
# Plasma style, colour scheme, Konsole profile). The orb, login screen and Settings' AI pages
# are ours (tripppin-ui). Inter is the interface font. Apps come as Flatpaks (Discover).
RUN dnf -y install --setopt=install_weak_deps=False \
      plasma-workspace plasma-desktop kwin plasma-nm plasma-pa bluedevil powerdevil kscreen kscreenlocker \
      kde-gtk-config xdg-desktop-portal-kde plasma-systemsettings kinfocenter plasma-print-manager polkit-kde \
      dolphin konsole ark gwenview okular spectacle kio-extras kde-cli-tools plasma-integration \
      kdegraphics-thumbnailers ffmpegthumbs breeze-icon-theme breeze-gtk plasma-breeze breeze-cursor-theme \
      plasma-discover plasma-discover-flatpak \
      greetd gtk4 gtk4-layer-shell libadwaita adwaita-icon-theme \
      rsms-inter-fonts mesa-dri-drivers pipewire pipewire-utils wireplumber pipewire-pulseaudio pipewire-alsa \
      mesa-libEGL mesa-libGL libglvnd-egl libglvnd-gles libglvnd-opengl libglvnd-glx \
      xdg-desktop-portal xdg-desktop-portal-gtk xdg-user-dirs \
      dconf polkit libnotify wl-clipboard brightnessctl playerctl \
      adw-gtk3-theme papirus-icon-theme papirus-icon-theme-dark qt6-qtwayland \
      bluez pulseaudio-utils upower power-profiles-daemon \
      glibc-langpack-en glibc-langpack-hi glibc-langpack-bn glibc-langpack-ta glibc-langpack-te \
      glibc-langpack-mr glibc-langpack-kn glibc-langpack-ml glibc-langpack-gu glibc-langpack-pa \
      glibc-langpack-es glibc-langpack-fr glibc-langpack-de glibc-langpack-pt \
      google-noto-sans-devanagari-vf-fonts google-noto-sans-bengali-vf-fonts google-noto-sans-tamil-vf-fonts \
      google-noto-sans-telugu-vf-fonts google-noto-sans-kannada-vf-fonts google-noto-sans-malayalam-vf-fonts \
      google-noto-sans-gujarati-vf-fonts google-noto-sans-gurmukhi-vf-fonts \
      firewalld orca espeak-ng speech-dispatcher speech-dispatcher-espeak-ng NetworkManager-openvpn NetworkManager-openvpn-gnome \
      cups cups-filters ipp-usb nss-mdns sane-backends sane-airscan simple-scan unicode-emoji wtype google-noto-color-emoji-fonts plymouth plymouth-plugin-script \
      gvfs gvfs-mtp \
      gnome-text-editor gnome-calculator celluloid gnome-system-monitor gnome-disk-utility \
      greenboot greenboot-default-health-checks \
    && dnf clean all

COPY os/files/ /
RUN test -x /usr/bin/startplasma-wayland && test -x /usr/bin/kwin_wayland && test -f /usr/share/icons/breeze_cursors/index.theme
# The desktop widgets reference, for people and for the AI (`tripppin-ui widgets guide`).
COPY docs/WIDGETS.md /usr/share/doc/tripppin/WIDGETS.md

# Branding. Keep ID, ID_LIKE, VERSION_ID, CPE_NAME and the Fedora support fields: bootc,
# bootc-image-builder, dnf ($releasever) and Anaconda read those to recognise the base.
# Change only what people see: the name, a VARIANT (display only; no VARIANT_ID, which
# Fedora's tooling uses to pick editions), the logo icon and colour, the home page, and
# DEFAULT_HOSTNAME, the name systemd gives a machine with no /etc/hostname (Fedora's says
# "fedora"). Machines that were already called "fedora" are renamed once by
# tripppin-hostname.service.
RUN set -e; f=/usr/lib/os-release; \
    sed -i \
      -e 's/^NAME=.*/NAME="Tripppin"/' \
      -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Tripppin 0.1 (Fedora 45 base)"/' \
      -e 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="tripppin"/' \
      -e 's/^LOGO=.*/LOGO=tripppin/' \
      -e 's/^ANSI_COLOR=.*/ANSI_COLOR="0;38;2;87;217;154"/' \
      -e 's|^HOME_URL=.*|HOME_URL="https://trippp.in/"|' \
      "$f"; \
    grep -q '^DEFAULT_HOSTNAME=' "$f" || echo 'DEFAULT_HOSTNAME="tripppin"' >> "$f"; \
    grep -q '^VARIANT=' "$f" || echo 'VARIANT="Tripppin"' >> "$f"; \
    grep -qx 'ID=fedora' "$f"; grep -qx 'DEFAULT_HOSTNAME="tripppin"' "$f"

# The login banner: the logo in text, then the system name and terminal.
RUN { trip logo --static --bare; printf '\n  \\S{PRETTY_NAME}  ·  \\l\n\n'; } > /etc/issue

# The desktop starts on tty1 through greetd; other consoles (Ctrl+Alt+F2…) are kmscon.
RUN systemctl enable tripppin-llm.service greetd.service bluetooth.service kmsconvt@.service firewalld.service cups.socket \
      tripppin-firefox.service tripppin-hostname.service greenboot-healthcheck.service greenboot-set-rollback-trigger.service \
    && systemctl set-default graphical.target \
    && dconf update \
    && fc-cache -f

# Icons: Papirus-Dark with the folders recoloured from Papirus blue to Tripppin greens, as
# a small theme of its own that inherits everything else.
RUN set -e; src=/usr/share/icons/Papirus; dst=/usr/share/icons/Tripppin; \
    for dir in "$src"/*/places; do \
      size=$(basename "$(dirname "$dir")"); mkdir -p "$dst/$size/places"; \
      for f in "$dir"/*.svg; do \
        real=$(readlink -f "$f"); grep -q '#5294e2' "$real" || continue; \
        sed -e 's/#5294e2/#3aa873/g; s/#4877b1/#1f6b45/g; s/#1d344f/#0d2a1c/g' "$real" > "$dst/$size/places/$(basename "$f")"; \
      done; \
    done; \
    sed -e 's/^Name=.*/Name=Tripppin/; s/^Comment=.*/Comment=Papirus-Dark with Tripppin folders/; s/^Inherits=.*/Inherits=Papirus-Dark,breeze-dark,hicolor/' \
      /usr/share/icons/Papirus-Dark/index.theme > "$dst/index.theme"; \
    gtk-update-icon-cache -q -f "$dst"; \
    test -f "$dst/48x48/places/folder.svg"

# The boot splash: our Plymouth theme, built into the initramfs so it shows from the start.
# A clean app list: hide helpers, duplicates and tool windows from Plasma's launcher (they
# still open from files and links), and give the two everyday apps plain names. Our
# Discover stays installed as a fallback, but our Store (in.trippp.Store) is the one in the launcher.
# Settings' own pages are found by searching "Settings" words instead of listing entries.
RUN cd /usr/share/applications \
    && for f in kdesystemsettings org.kde.kmenuedit org.kde.plasma.emojier org.kde.ark org.kde.kinfocenter \
         org.gnome.SimpleScan org.kde.plasma-systemmonitor org.kde.kuserfeedback-console \
         org.freedesktop.IBus.Panel.Emojier org.freedesktop.IBus.Panel.Extension.Gtk3 \
         org.freedesktop.IBus.Setup nm-connection-editor \
         org.kde.discover org.kde.discover.notifier org.kde.discover.urlhandler; do \
         [ ! -f "$f.desktop" ] || sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f.desktop"; \
       done \
    && for d in in.trippp.Settings.*.desktop; do sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$d"; done \
    && sed -i -e '/^Name\[/d' -e '/^GenericName\[/d' -e 's/^Name=Konsole$/Name=Terminal/' org.kde.konsole.desktop \
    && sed -i -e '/^Name\[/d' -e '/^GenericName\[/d' -e 's/^Name=Dolphin$/Name=Files/' org.kde.dolphin.desktop \
    && ! grep -q NoDisplay in.trippp.Settings.desktop

RUN plymouth-set-default-theme tripppin \
    && kver=$(cd /usr/lib/modules && echo *) \
    && DRACUT_NO_XATTR=1 dracut -f --no-hostonly --reproducible "/usr/lib/modules/$kver/initramfs.img" "$kver" \
    && lsinitrd "/usr/lib/modules/$kver/initramfs.img" | grep -q plymouth/themes/tripppin

# Fails the build if the image breaks bootc's rules (e.g. content in /var it can't manage).
RUN bootc container lint
