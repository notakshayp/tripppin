// The login screen's own tiny session: niri shows only tripppin-ui greeter, with no
// key bindings, and quits once someone has logged in.
hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

spawn-at-startup "sh" "-c" "tripppin-ui displays; tripppin-ui greeter; niri msg action quit --skip-confirmation"

binds {
}

// Ink behind the login screen, so the moment before it draws matches the console and splash.
layout {
    background-color "#0b100f"
}
