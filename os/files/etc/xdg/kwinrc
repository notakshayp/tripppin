# KWin: quiet window frames, quick tiling on (Meta + arrows, drag a window to an edge or a
# corner), and a Meta tap that opens the bridge (tripppin-ui bridge, through the
# Open-the-launcher global shortcut). The frame is our QML decoration: square, flat, a 36 px
# strip (os/files/usr/share/kwin/decorations/kwin4_decoration_qml_tripppin).
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=kwin4_decoration_qml_tripppin
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[Windows]
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerRatio=0.25
FocusPolicy=ClickToFocus
Placement=Centered
BorderlessMaximizedWindows=true

[ModifierOnlyShortcuts]
Meta=org.kde.kglobalaccel,/component/in_trippp_Launcher_desktop,org.kde.kglobalaccel.Component,invokeShortcut,_launch

# Motion: windows fade in and out (fade), minimise squashes toward the taskbar (squash), menus and
# popups fade (fadingpopups); durations are the global AnimationDurationFactor in kdeglobals
# (0.8, about 200 ms). No wobbly, magic lamp, glide, scale or sliding popups.
[Plugins]
blurEnabled=true
contrastEnabled=true
wobblywindowsEnabled=false
magiclampEnabled=false
squashEnabled=true
glideEnabled=false
scaleEnabled=false
fadeEnabled=true
fadingpopupsEnabled=true
maximizeEnabled=true
overviewEnabled=true
slidingpopupsEnabled=false

[Effect-blur]
BlurStrength=6
NoiseStrength=0

[NightColor]
Active=false

[TabBox]
LayoutName=thumbnail_grid

[Desktops]
Number=3
Rows=1
