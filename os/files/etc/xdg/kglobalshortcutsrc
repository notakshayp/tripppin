# Tripppin's keyboard shortcuts (the niri ones, translated). Format: current,default,name.
# A person's own ~/.config/kglobalshortcutsrc wins. Meta is the Super / Windows key.

[services][in.trippp.Ask.desktop]
_launch=Meta+Space,none,Ask Tripppin

[services][in.trippp.Dictate.desktop]
_launch=Meta+M,none,Dictate

[services][in.trippp.Launcher.desktop]
_launch=Meta+A\tMeta+D,none,Open the launcher

[services][in.trippp.Keys.desktop]
_launch=Meta+/,none,Keyboard shortcuts

[services][org.kde.konsole.desktop]
_launch=Meta+Return\tCtrl+Alt+T,Ctrl+Alt+T,Konsole

[services][org.kde.plasma.emojier.desktop]
_launch=Meta+.,Meta+.,Emoji Selector

[services][org.kde.spectacle.desktop]
_launch=Print,Print,Launch Spectacle
ActiveWindowScreenShot=Alt+Print,Meta+Print,Capture Active Window
FullScreenScreenShot=Ctrl+Print,Shift+Print,Capture Entire Desktop
RectangularRegionScreenShot=Meta+Shift+S,Meta+Shift+Print,Capture Rectangular Region
RecordRegion=Meta+Shift+R,Meta+Shift+R,Record a Rectangular Region
RecordScreen=Meta+Alt+R,Meta+Alt+R,Record Screen
RecordWindow=Meta+Ctrl+R,Meta+Ctrl+R,Record Window

[org_kde_klipper]
show-on-mouse-pos=Meta+V,Meta+V,Show Clipboard Items at Mouse Position

[ksmserver]
Lock Session=Meta+L\tCtrl+Meta+L,Meta+L\tScreensaver,Lock Session
Log Out=Meta+Escape\tCtrl+Alt+Del,Ctrl+Alt+Del,Show Logout Prompt
Log Out Without Confirmation=Meta+Shift+E,none,Log Out Without Confirmation

[kwin]
Overview=Meta+Tab,Meta+W,Toggle Overview
Walk Through Windows=Alt+Tab,Alt+Tab,Walk Through Windows
Walk Through Windows (Reverse)=Alt+Shift+Tab,Alt+Shift+Tab,Walk Through Windows (Reverse)
Window Close=Meta+Q\tAlt+F4,Alt+F4,Close Window
Window Fullscreen=Meta+F,none,Make Window Fullscreen
Window Keep Above=Meta+T,none,Keep Window Above Others
Window Maximize=Meta+Up\tCtrl+Alt+Return,Meta+PgUp,Maximize Window
Window Minimize=Meta+Down,Meta+PgDown,Minimize Window
Window Move Center=Meta+C\tCtrl+Alt+C,none,Move Window to the Center
Window Quick Tile Left=Meta+Left\tCtrl+Alt+Left,Meta+Left,Quick Tile Window to the Left
Window Quick Tile Right=Meta+Right\tCtrl+Alt+Right,Meta+Right,Quick Tile Window to the Right
Window Quick Tile Top=Ctrl+Alt+Up,none,Quick Tile Window to the Top
Window Quick Tile Bottom=Ctrl+Alt+Down,none,Quick Tile Window to the Bottom
Window Quick Tile Top Left=Meta+Alt+Left\tCtrl+Alt+U,none,Quick Tile Window to the Top Left
Window Quick Tile Top Right=Meta+Alt+Up\tCtrl+Alt+I,none,Quick Tile Window to the Top Right
Window Quick Tile Bottom Left=Meta+Alt+Down\tCtrl+Alt+J,none,Quick Tile Window to the Bottom Left
Window Quick Tile Bottom Right=Meta+Alt+Right\tCtrl+Alt+K,none,Quick Tile Window to the Bottom Right
Switch to Desktop 1=Meta+1,Ctrl+F1,Switch to Desktop 1
Switch to Desktop 2=Meta+2,Ctrl+F2,Switch to Desktop 2
Switch to Desktop 3=Meta+3,Ctrl+F3,Switch to Desktop 3
Window to Desktop 1=Meta+Shift+1,none,Window to Desktop 1
Window to Desktop 2=Meta+Shift+2,none,Window to Desktop 2
Window to Desktop 3=Meta+Shift+3,none,Window to Desktop 3
