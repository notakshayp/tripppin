{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 12,
  "control-center-margin-left": 0,
  "control-center-width": 384,
  "notification-window-width": 360,
  "notification-icon-size": 32,
  "notification-body-image-height": 120,
  "notification-body-image-width": 240,
  "notification-inline-replies": true,
  "notification-2fa-action": true,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-height": -1,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 260,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "No notifications",
  "widgets": [
    "title",
    "buttons-grid",
    "menubar",
    "slider#volume",
    "backlight",
    "mpris",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Quick settings",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "\ue1ae   Wi-Fi",
          "type": "toggle",
          "command": "tripppin-ui toggle wifi",
          "update-command": "tripppin-ui toggle wifi --state"
        },
        {
          "label": "\ue05c   Bluetooth",
          "type": "toggle",
          "command": "tripppin-ui toggle bluetooth",
          "update-command": "tripppin-ui toggle bluetooth --state"
        },
        {
          "label": "\ue1de   Airplane",
          "type": "toggle",
          "command": "tripppin-ui toggle airplane",
          "update-command": "tripppin-ui toggle airplane --state"
        },
        {
          "label": "\ue11e   Night light",
          "type": "toggle",
          "command": "tripppin-ui toggle night-light",
          "update-command": "tripppin-ui toggle night-light --state"
        },
        {
          "label": "\ue14e   Screenshot",
          "command": "swaync-client -cp; sleep 0.4; slurp | grim -g - - | swappy -f -"
        },
        {
          "label": "\ue10b   Lock",
          "command": "sh -c 'swaync-client -cp; tripppin-ui lock'"
        },
        {
          "label": "\ue154   Settings",
          "command": "sh -c 'swaync-client -cp; tripppin-ui settings'"
        },
        {
          "label": "\ue140   Power",
          "command": "sh -c 'swaync-client -cp; tripppin-power'"
        }
      ]
    },
    "slider#volume": {
      "label": "\ue1ab",
      "cmd_getter": "/usr/libexec/tripppin-volume get",
      "cmd_setter": "/usr/libexec/tripppin-volume set $value",
      "min": 0,
      "max": 100,
      "min_limit": 0,
      "max_limit": 100
    },
    "backlight": {
      "label": "\ue178",
      "min": 5
    },
    "mpris": {
      "image-size": 48,
      "image-radius": 10
    },
    "menubar": {
      "buttons#settings": {
        "position": "left",
        "actions": [
          {
            "label": "\ue1ae  Networks",
            "command": "sh -c 'swaync-client -cp; tripppin-ui settings wifi'"
          },
          {
            "label": "\ue05c  Devices",
            "command": "sh -c 'swaync-client -cp; tripppin-ui settings bluetooth'"
          },
          {
            "label": "\ue1ab  Sound",
            "command": "sh -c 'swaync-client -cp; tripppin-ui settings sound'"
          },
          {
            "label": "\ue11d  Display",
            "command": "sh -c 'swaync-client -cp; tripppin-ui settings display'"
          }
        ]
      }
    }
  }
}
