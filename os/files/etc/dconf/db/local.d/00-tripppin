# Defaults for GTK and libadwaita apps: dark, green accent, Inter and DM Mono.
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
accent-color='green'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='DM Mono 11'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
clock-format='24h'
