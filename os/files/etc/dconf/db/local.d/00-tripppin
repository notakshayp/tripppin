# Defaults for GTK and libadwaita apps: dark, green accent, Inter and DM Mono at 11 pt
# (about 15 px, readable at scale 1), greyscale-antialiased with slight hinting.
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
accent-color='green'
font-name='Manrope 11'
document-font-name='Manrope 11'
monospace-font-name='DM Mono 11'
font-antialiasing='grayscale'
font-hinting='slight'
icon-theme='Tripppin'
cursor-theme='breeze_cursors'
clock-format='24h'

[org/gnome/TextEditor]
style-scheme='tripppin'
