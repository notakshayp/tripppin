# Defaults for GTK and libadwaita apps: dark, green accent, Inter and DM Mono at a compact
# 10 pt, greyscale-antialiased with slight hinting (sharp at scale 1).
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
accent-color='green'
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='DM Mono 10'
font-antialiasing='grayscale'
font-hinting='slight'
icon-theme='Tripppin'
cursor-theme='Adwaita'
clock-format='24h'

[org/gnome/TextEditor]
style-scheme='tripppin'
