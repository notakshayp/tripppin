// The first-boot screen starts the AI service once the model is downloaded; let
// administrators (wheel) start, stop and restart just that service without a prompt.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "tripppin-llm.service" &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});

// Settings → Date & time and Language: administrators set the time zone, automatic time
// and the system language without a password.
polkit.addRule(function (action, subject) {
    if ((action.id == "org.freedesktop.timedate1.set-timezone" ||
         action.id == "org.freedesktop.timedate1.set-ntp" ||
         action.id == "org.freedesktop.locale1.set-locale") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});

// Settings → Updates and About: administrators check for updates, go back to the previous
// version, restart, and name the computer without a password.
polkit.addRule(function (action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "bootc-fetch-apply-updates.service") {
        return polkit.Result.YES;
    }
    if (action.id == "org.projectatomic.rpmostree1.rollback" ||
        action.id == "org.freedesktop.hostname1.set-static-hostname" ||
        action.id == "org.freedesktop.hostname1.set-hostname") {
        return polkit.Result.YES;
    }
});

// The Store (tripppin-ui store, trip store): administrators install, update and remove
// Flatpak apps for everyone on the computer without a password (Flatpak's own rule for
// the wheel group does the same on Fedora; this keeps it true if that file changes).
polkit.addRule(function (action, subject) {
    if (action.id.indexOf("org.freedesktop.Flatpak.") == 0 &&
        action.id != "org.freedesktop.Flatpak.install-bundle" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
