#!/bin/sh
# Writes standard input to a settings file under /etc, for the AI's "System settings files"
# permission (Settings → AI → Permissions):
#
#   printf '%s\n' 'new contents' | sudo /usr/libexec/tripppin-etc-write /etc/some/file.conf
#
# Only files under /etc, never the ones that hold passwords, sudo, login or polkit rules, or
# Tripppin's own AI permissions. The old file is kept in /var/lib/tripppin/etc-backups, and a
# new file keeps the old one's owner and mode (0644 root otherwise).
set -eu
[ "$(id -u)" = 0 ] || { echo "run this with sudo" >&2; exit 2; }
[ $# = 1 ] || { echo "usage: tripppin-etc-write /etc/<file> < contents" >&2; exit 2; }
target=$(realpath -m -- "$1")
case $target in
    /etc/?*) ;;
    *) echo "only files under /etc: $target" >&2; exit 2 ;;
esac
case $target in
    /etc/passwd|/etc/passwd-|/etc/shadow*|/etc/group|/etc/group-|/etc/gshadow*|/etc/subuid*|/etc/subgid*|\
    /etc/sudoers|/etc/sudoers.d|/etc/sudoers.d/*|/etc/pam.d|/etc/pam.d/*|/etc/security/*|\
    /etc/polkit-1/*|/etc/tripppin/ai-*|/etc/ssh/*key*|/etc/login.defs|/etc/selinux/*|/etc/fstab|/etc/crypttab)
        echo "not allowed to write $target; it needs a person to change it" >&2
        exit 3 ;;
esac
[ ! -d "$target" ] || { echo "$target is a folder" >&2; exit 2; }
dir=$(dirname -- "$target")
mkdir -p -- "$dir"
tmp=$(mktemp -- "$dir/.tripppin-etc-write.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
if [ -e "$target" ]; then
    backups=/var/lib/tripppin/etc-backups
    mkdir -p -m 0700 "$backups"
    cp -a -- "$target" "$backups/$(echo "${target#/}" | tr / _).$(date +%Y%m%d-%H%M%S)"
    chown --reference="$target" "$tmp"
    chmod --reference="$target" "$tmp"
else
    chmod 0644 "$tmp"
fi
command -v restorecon > /dev/null && restorecon -- "$tmp" 2> /dev/null || true
mv -f -- "$tmp" "$target"
command -v restorecon > /dev/null && restorecon -- "$target" 2> /dev/null || true
logger -t tripppin-etc-write "wrote $target for ${SUDO_USER:-root}" 2> /dev/null || true
echo "wrote $target"
