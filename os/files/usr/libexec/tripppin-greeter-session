#!/bin/sh
# The login screen, as greetd runs it on tty1 (/etc/greetd/config.toml): KWin showing only
# tripppin-ui greeter, no lock screen and no shortcuts, quitting when someone has logged in.
# Messages go to the journal rather than the console, and the console is kept plain ink, so
# nothing but ink shows while the screen changes hands.
/usr/libexec/tripppin-ink-console
systemd-cat -t tripppin-greeter kwin_wayland --no-lockscreen --no-global-shortcuts --exit-with-session "tripppin-ui greeter"
status=$?
# If KWin couldn't start, greetd will retry; leave the console readable meanwhile.
[ "$status" -eq 0 ] || /usr/libexec/tripppin-ink-console reset
exit "$status"
