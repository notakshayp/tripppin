#!/bin/sh
# Once per machine (tripppin-hostname.service): a computer installed before Tripppin had its
# own default name may still be called "fedora", or an installer placeholder. Call it
# "tripppin" instead. Any other name was chosen by someone and is never touched; with no
# /etc/hostname at all, systemd already uses DEFAULT_HOSTNAME from os-release.
set -u
mkdir -p /var/lib/tripppin
name=$(tr -d '[:space:]' < /etc/hostname 2>/dev/null || true)
case "$name" in
    fedora | localhost | localhost.localdomain | localhost-live)
        if ! hostnamectl set-hostname tripppin 2>/dev/null; then
            echo tripppin > /etc/hostname
            hostname tripppin
        fi
        echo "renamed this computer from $name to tripppin"
        ;;
esac
touch /var/lib/tripppin/hostname-checked
