#!/bin/sh
# The desktop session greetd starts after the login screen (tripppin-ui greeter asks for it).
# The login screen has already faded to ink; keep the console ink too and send niri-session's
# messages to the journal, so the next thing on screen is the desktop's splash
# (tripppin-ui splash, first in /etc/niri/desktop.kdl), not text.
/usr/libexec/tripppin-ink-console
exec systemd-cat -t niri-session niri-session
