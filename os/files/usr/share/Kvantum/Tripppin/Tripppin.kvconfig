[%General]
author=Tripppin
comment=Bento: rounded tiles on graphite, amber accent (generated by scripts/kvantum-theme.py)
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
composite=true
menu_shadow_depth=8
tooltip_shadow_depth=6
translucent_windows=false
blurring=false
popup_blurring=false
splitter_width=6
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=6
slider_handle_width=14
slider_handle_length=14
check_size=16
toolbar_icon_size=16
animate_states=true
transient_groove=false
transient_scrollbar=true
reduce_window_opacity=0
reduce_menu_opacity=0
layout_spacing=4
layout_margin=6
submenu_overlap=0
scrollbar_in_view=true
tree_branch_line=false

[GeneralColors]
window.color=#16181a
base.color=#111314
alt.base.color=#16181a
button.color=#23272a
light.color=#2e3337
mid.light.color=#23272a
dark.color=#111314
mid.color=#2e3337
highlight.color=#f2b84b
inactive.highlight.color=#3a3f43
text.color=#f1f3f4
window.text.color=#f1f3f4
button.text.color=#f1f3f4
disabled.text.color=#4b555c
tooltip.text.color=#f1f3f4
highlight.text.color=#16181a
link.color=#f2b84b
link.visited.color=#9aa3a8

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
blur_translucent=false
no_selection_tint=true

[PanelButtonCommand]
frame=true
frame.element=button
interior=true
interior.element=button
indicator.size=9
text.normal.color=#f1f3f4
text.focus.color=#f1f3f4
text.press.color=#16181a
text.toggle.color=#16181a
text.shadow=0
text.margin=1
text.iconspacing=4
indicator.element=arrow
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
text.margin.top=3
text.margin.bottom=3
text.margin.left=4
text.margin.right=4
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=dock
interior.element=dock

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.focus.color=#f1f3f4
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=2
text.margin.right=2
text.margin.top=0
text.margin.bottom=0
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin.left=10
text.margin.right=10
text.margin.top=5
text.margin.bottom=5
frame.element=tab
indicator.element=tab
min_width=+2
min_height=2.0font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
text.margin.top=3
text.margin.bottom=3

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
frame.element=toolbar
interior=false

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider

frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.focus.color=#f1f3f4
text.press.color=#f1f3f4
text.toggle.color=#f1f3f4
text.bold=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern

frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ItemView]
inherits=PanelButtonCommand
text.margin=1
frame.element=itemview
interior.element=itemview
text.normal.color=#f1f3f4
text.focus.color=#f1f3f4
text.press.color=#f1f3f4
text.toggle.color=#f1f3f4
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[Splitter]
inherits=PanelButtonCommand
interior.element=splitter
frame.element=splitter
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
indicator.element=grip
indicator.size=13
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false

frame.top=5
frame.bottom=5
frame.left=5
frame.right=5

[ScrollbarGroove]
inherits=PanelButtonCommand
interior.element=scrollbargroove
frame.element=scrollbargroove
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.focus.color=#16181a
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
text.margin.left=8
text.margin.right=8
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
text.normal.color=#9aa3a8
text.focus.color=#f1f3f4
text.bold=true
text.italic=false

[ComboBox]
inherits=PanelButtonCommand

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=14
frame.bottom=14
frame.left=14
frame.right=14

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
text.margin=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[ToolTip]
inherits=GenericFrame
interior=true
text.margin=2
interior.element=tooltip
frame.element=tooltip
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
