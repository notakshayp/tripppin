[%General]
author=Tripppin
comment=Tiles: flat, square, solid colour (generated by scripts/kvantum-theme.py)
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=4
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
translucent_windows=false
blurring=false
popup_blurring=false
splitter_width=6
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=4
slider_handle_width=12
slider_handle_length=12
check_size=16
toolbar_icon_size=16
animate_states=true
transient_groove=false
transient_scrollbar=true
reduce_window_opacity=0
reduce_menu_opacity=0
layout_spacing=4
layout_margin=6
submenu_overlap=0
scrollbar_in_view=true
tree_branch_line=false

[GeneralColors]
window.color=#101418
base.color=#0b0e11
alt.base.color=#101418
button.color=#1a2025
light.color=#222a30
mid.light.color=#1a2025
dark.color=#0b0e11
mid.color=#2a3238
highlight.color=#1f6b45
inactive.highlight.color=#3a4a5a
text.color=#ffffff
window.text.color=#ffffff
button.text.color=#ffffff
disabled.text.color=#4b555c
tooltip.text.color=#ffffff
highlight.text.color=#ffffff
link.color=#3fae7a
link.visited.color=#9aa4ab

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
blur_translucent=false
no_selection_tint=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
interior.element=button
indicator.size=9
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.shadow=0
text.margin=1
text.iconspacing=4
indicator.element=arrow
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
text.margin.top=3
text.margin.bottom=3
text.margin.left=4
text.margin.right=4

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=dock
interior.element=dock

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.focus.color=#ffffff
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4
text.margin.top=3
text.margin.bottom=3

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
interior.element=tab
text.margin.left=10
text.margin.right=10
text.margin.top=5
text.margin.bottom=5
frame.element=tab
indicator.element=tab
min_width=+2
min_height=2.0font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
text.margin.top=3
text.margin.bottom=3

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
frame.element=toolbar
interior=false

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[ItemView]
inherits=PanelButtonCommand
text.margin=1
frame.element=itemview
interior.element=itemview
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff

[Splitter]
inherits=PanelButtonCommand
interior.element=splitter
frame.element=splitter
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0
indicator.element=grip
indicator.size=13

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior.element=scrollbargroove
frame.element=scrollbargroove
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.focus.color=#ffffff
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
text.margin.left=8
text.margin.right=8

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
text.normal.color=#9aa4ab
text.focus.color=#ffffff
text.bold=true
text.italic=false

[ComboBox]
inherits=PanelButtonCommand

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
text.margin=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[ToolTip]
inherits=GenericFrame
interior=true
text.margin=2
interior.element=tooltip
frame.element=tooltip

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
