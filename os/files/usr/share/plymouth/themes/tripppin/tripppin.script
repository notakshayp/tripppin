// Tripppin's boot screen: on ink, the green spark appears, then the ring draws itself,
// then makes a gentle quarter turn every couple of seconds while the computer starts; and a
// password prompt for encrypted disks. Colours from the brand: ink #0d1211, paper #f2f5ef.
// The images come from scripts/brand-assets.sh (2x, the mark's 146 x 175 box at 292 x 350);
// the timing follows crates/trip/src/logo.rs. Plymouth calls refresh() 50 times a second.

Window.SetBackgroundTopColor(0.051, 0.071, 0.067);
Window.SetBackgroundBottomColor(0.051, 0.071, 0.067);

RING_FRAMES = 24;
for (i = 1; i <= RING_FRAMES; i++) ring_frames[i] = Image("ring-" + i + ".png");
ring_image = Image("ring.png");
spark_image = Image("spark.png");
x = Window.GetX() + Window.GetWidth() / 2 - ring_image.GetWidth() / 2;
y = Window.GetY() + Window.GetHeight() / 2 - ring_image.GetHeight() / 2 - 20;
// The spark's centre: (100, 50) in logo units, from the box's corner at (27, 12), at 2x.
spark_cx = x + 146;
spark_cy = y + 76;

ring = Sprite();
ring.SetPosition(x, y, 1);
spark = Sprite();
spark.SetZ(2);

fun ease_out(t) {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    return 1 - (1 - t) * (1 - t) * (1 - t);
}

fun smooth(t) {
    if (t <= 0) return 0;
    if (t >= 1) return 1;
    return t * t * (3 - 2 * t);
}

// Places the spark turned `turn` radians past rest and scaled by `scale`, about its centre.
fun show_spark(scale, turn) {
    if (scale <= 0.01) {
        spark.SetOpacity(0);
        return;
    }
    image = spark_image.Rotate(turn);
    w = Math.Int(image.GetWidth() * scale);
    h = Math.Int(image.GetHeight() * scale);
    if (scale != 1) image = image.Scale(w, h);
    spark.SetImage(image);
    spark.SetPosition(spark_cx - w / 2, spark_cy - h / 2, 2);
    spark.SetOpacity(1);
}

frame = 0;
shown_ring = 0;
resting = 0;
fun refresh() {
    frame++;
    t = frame / 50;
    // The spark first, growing into place over 0.35 s without turning.
    if (t < 0.4) {
        u = t / 0.35;
        if (u > 1) u = 1;
        show_spark(ease_out(u), 0);
    } else if (resting == 0) {
        show_spark(1, 0);
        resting = 1;
    }
    // Then the ring, from 0.3 s to 0.95 s, from its left end down and round.
    u = (t - 0.3) / 0.65;
    if (u < 0) u = 0;
    n = Math.Int(ease_out(u) * RING_FRAMES + 0.5);
    if (n < 1) n = 1;
    if (n > RING_FRAMES) n = RING_FRAMES;
    if (u > 0 && n != shown_ring) {
        ring.SetImage(ring_frames[n]);
        shown_ring = n;
    }
}
Plymouth.SetRefreshFunction(refresh);

// The disk's password, when it's encrypted: a prompt and dots under the logo.
prompt_sprite = Sprite();
dots_sprite = Sprite();
fun show_password(prompt, bullets) {
    text = prompt;
    if (text == "") text = "password for this disk";
    prompt_image = Image.Text(text, 0.56, 0.64, 0.61, 1, "Inter 13");
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(Window.GetWidth() / 2 - prompt_image.GetWidth() / 2, y + ring_image.GetHeight() + 30, 3);
    dots = "";
    for (i = 0; i < bullets; i++) dots += "● ";
    dots_image = Image.Text(dots, 0.95, 0.96, 0.94, 1, "Inter 15");
    dots_sprite.SetImage(dots_image);
    dots_sprite.SetPosition(Window.GetWidth() / 2 - dots_image.GetWidth() / 2, y + ring_image.GetHeight() + 60, 3);
}
Plymouth.SetDisplayPasswordFunction(show_password);

fun back_to_normal() {
    prompt_sprite.SetOpacity(0);
    dots_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(back_to_normal);

// Messages (a filesystem check, an update being applied) in small grey type.
message_sprite = Sprite();
fun show_message(text) {
    message_image = Image.Text(text, 0.56, 0.64, 0.61, 1, "Inter 12");
    message_sprite.SetImage(message_image);
    message_sprite.SetPosition(Window.GetWidth() / 2 - message_image.GetWidth() / 2, Window.GetHeight() - 80, 3);
}
Plymouth.SetMessageFunction(show_message);
