<?xml version="1.0" encoding="UTF-8"?>
<!-- Text Editor and other GtkSourceView apps in Tripppin's colours: ink page, paper text,
     green for the cursor, selection and what matters in code. -->
<style-scheme id="tripppin" name="Tripppin" version="1.0" kind="dark">
  <author>Tripppin</author>
  <description>Ink, paper and spark green.</description>

  <color name="ink" value="#0d1211"/>
  <color name="ink-2" value="#141b19"/>
  <color name="ink-3" value="#1b2421"/>
  <color name="paper" value="#f2f5ef"/>
  <color name="muted" value="#8fa39b"/>
  <color name="green" value="#57d99a"/>
  <color name="forest" value="#1f6b45"/>
  <color name="amber" value="#e8c26e"/>
  <color name="coral" value="#ff8a7a"/>

  <style name="text" foreground="paper" background="ink"/>
  <style name="cursor" foreground="green"/>
  <style name="selection" foreground="paper" background="forest"/>
  <style name="current-line" background="ink-2"/>
  <style name="line-numbers" foreground="muted" background="ink"/>
  <style name="current-line-number" foreground="paper" background="ink-2"/>
  <style name="bracket-match" foreground="green" bold="true"/>
  <style name="search-match" background="#2a5a40"/>
  <style name="right-margin" foreground="ink-3" background="ink-2"/>

  <style name="def:comment" foreground="muted" italic="true"/>
  <style name="def:string" foreground="amber"/>
  <style name="def:keyword" foreground="green" bold="true"/>
  <style name="def:type" foreground="green"/>
  <style name="def:number" foreground="coral"/>
  <style name="def:constant" foreground="coral"/>
  <style name="def:function" foreground="paper" bold="true"/>
  <style name="def:preprocessor" foreground="green"/>
  <style name="def:error" foreground="coral" underline="error"/>
  <style name="def:heading" foreground="green" bold="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:link-text" foreground="green" underline="single"/>
</style-scheme>
