#!/bin/sh
# Compatibility for callers that still launch `foot` (the orb's "continue in terminal"):
# opens Konsole instead. Understands foot's `--title T -- command...` form. Remove once
# nothing asks for foot.
title=""
while [ $# -gt 0 ]; do
  case "$1" in
    --title|-T) title=$2; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [ $# -gt 0 ]; then
  exec konsole ${title:+-p "tabtitle=$title"} -e "$@"
fi
exec konsole
