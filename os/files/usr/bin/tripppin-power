#!/bin/sh
# The power menu, centred on the focused screen whatever its size: five buttons (172px
# wide plus 12px margins each side) in a row, with equal space either side.
pgrep -x wlogout >/dev/null && { pkill -x wlogout; exit 0; }
size=$(niri msg -j focused-output 2>/dev/null | sed -n 's/.*"logical":{[^}]*"width":\([0-9]*\),"height":\([0-9]*\).*/\1 \2/p')
width=${size% *}; height=${size#* }
[ -n "$width" ] || { width=1280; height=800; }
row=$((5 * 196))
side=$(( (width - row) / 2 )); [ "$side" -lt 0 ] && side=0
top=$(( (height - 160) / 2 )); [ "$top" -lt 0 ] && top=0
exec wlogout -b 5 -L "$side" -R "$side" -T "$top" -B "$top"
