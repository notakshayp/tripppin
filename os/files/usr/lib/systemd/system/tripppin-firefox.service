[Unit]
Description=Install Firefox from Flathub on first boot
Documentation=https://github.com/notakshayp/tripppin
# Once only: the marker file says it's done.
ConditionPathExists=!/var/lib/tripppin/firefox-installed
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak install -y --noninteractive --system flathub org.mozilla.firefox
ExecStartPost=/usr/bin/touch /var/lib/tripppin/firefox-installed
# No network yet (Wi-Fi not set up): try again later rather than giving up.
Restart=on-failure
RestartSec=10min

[Install]
WantedBy=multi-user.target
