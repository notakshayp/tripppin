[Unit]
Description=Tripppin local model (llama.cpp server)
Documentation=https://github.com/notakshayp/tripppin
After=network.target
# Nothing to run until a model has been downloaded with `sudo trip model pull`.
ConditionDirectoryNotEmpty=/var/lib/tripppin/models

[Service]
ExecStart=/usr/bin/trip model serve
Restart=on-failure
RestartSec=5

# Runs as a throwaway user that can read the models and the GPU, and nothing else.
DynamicUser=yes
SupplementaryGroups=render video
ReadOnlyPaths=/var/lib/tripppin/models
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Only this machine can talk to it.
IPAddressDeny=any
IPAddressAllow=localhost

# Never compete with the desktop for CPU.
Nice=10
CPUWeight=50

[Install]
WantedBy=multi-user.target
