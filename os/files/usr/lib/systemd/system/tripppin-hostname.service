[Unit]
Description=Rename a computer still called "fedora" to "tripppin" (once)
Documentation=https://trippp.in/
# Runs once per machine; a name someone chose is left alone (see the script).
ConditionPathExists=!/var/lib/tripppin/hostname-checked
After=local-fs.target dbus.service
Wants=dbus.service
Before=NetworkManager.service greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/tripppin-hostname

[Install]
WantedBy=multi-user.target
